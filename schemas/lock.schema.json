{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://letta-master-builder.local/schemas/lock.schema.json",
  "title": "Revision 0.4 release-candidate reproducibility lock",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "curriculum_id", "curriculum_version", "design_revision", "target_contract", "generator", "generation_baseline", "lock_state", "generated_at", "required_files", "docs_snapshot", "agent_sdk", "sdk_declared_runtime", "standalone_runtime", "hosted_runtime", "canary_evidence_ids", "notes"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "curriculum_id": {"const": "letta-master-builder"},
    "curriculum_version": {"const": "0.4.0"},
    "design_revision": {"const": "0.4"},
    "target_contract": {"type": "object", "additionalProperties": false, "required": ["primary_persona", "domain_baseline", "language", "teaching_mode", "implementation_language", "mandatory_path", "primary_runtime_lane", "contrast_runtime_lane", "direct_app_server", "remote_client", "agent_foundry", "evidence_cutoff_semantics", "side_effects", "word_budget", "completion", "runtime_claims", "autonomous_execution"], "properties": {"primary_persona": {"const": "technically-proficient-coding-agent"}, "domain_baseline": {"const": "zero-prior-letta-knowledge"}, "language": {"const": "en"}, "implementation_language": {"const": "TypeScript"}, "evidence_cutoff_semantics": {"const": "latest-exactly-verified-at-release-cutoff"}, "side_effects": {"const": "forbidden-without-separate-explicit-authorization"}, "word_budget": {"type": "object", "additionalProperties": false, "required": ["mandatory_prose_min", "mandatory_prose_max", "current_prose", "complete"], "properties": {"mandatory_prose_min": {"const": 70000}, "mandatory_prose_max": {"const": 74000}, "current_prose": {"type": "integer", "minimum": 70000, "maximum": 74000}, "complete": {"const": true}}}, "agent_foundry": {"const": "conceptual-only"}, "direct_app_server": {"const": "awareness"}, "remote_client": {"const": "awareness"}, "mandatory_path": {"const": "agent-sdk"}, "teaching_mode": {"const": "read-only"}, "primary_runtime_lane": {"const": "agent-sdk-node-local"}, "contrast_runtime_lane": {"const": "agent-sdk-node-cloud"}, "completion": {"const": true}, "runtime_claims": {"const": false}, "autonomous_execution": {"const": false}}},
    "generator": {"type": "object", "additionalProperties": false, "required": ["identity", "version"], "properties": {"identity": {"const": "scripts/generate-lock.mjs"}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}}},
    "generation_baseline": {"type": "object", "additionalProperties": false, "required": ["timestamp", "semantics"], "properties": {"timestamp": {"type": "string", "format": "date-time"}, "semantics": {"type": "string", "minLength": 1}}},
    "lock_state": {"const": "generated-release-candidate"},
    "generated_at": {"type": "string", "format": "date-time"},
    "required_files": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}},
    "docs_snapshot": {"$ref": "#/$defs/evidence"},
    "agent_sdk": {"$ref": "#/$defs/packageEvidence"},
    "sdk_declared_runtime": {"$ref": "#/$defs/packageEvidence"},
    "standalone_runtime": {"$ref": "#/$defs/packageEvidence"},
    "hosted_runtime": {"type": "object", "additionalProperties": false, "required": ["status"], "properties": {"status": {"const": "unknown-not-tested"}}},
    "canary_evidence_ids": {"type": "array", "maxItems": 0},
    "notes": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "$defs": {
    "evidence": {"type": "object", "additionalProperties": false, "required": ["source_id", "checked_at", "sha256"], "properties": {"source_id": {"type": "string", "pattern": "^SRC-[A-Z0-9.-]+$"}, "checked_at": {"type": "string", "format": "date"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "packageEvidence": {"type": "object", "additionalProperties": false, "required": ["package", "version", "integrity", "commit"], "properties": {"package": {"type": "string", "minLength": 1}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "integrity": {"type": ["string", "null"]}, "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}}}
  }
}
