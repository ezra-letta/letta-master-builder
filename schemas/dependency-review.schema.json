{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://letta-master-builder.local/schemas/dependency-review.schema.json",
  "x-target": "release/dependency-review.yml",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "status", "reviewed_at", "scope", "lock_package_records", "direct_dependencies", "license_counts", "license_notes", "install_script_packages", "install_policy", "vulnerability_audit", "redistribution", "decision", "runtime_claim"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"const": "REL-DEPENDENCY-REVIEW-0-4"},
    "status": {"const": "publication-blocked"},
    "reviewed_at": {"type": "string", "format": "date"},
    "scope": {"type": "string", "minLength": 1},
    "lock_package_records": {"type": "integer", "minimum": 1},
    "direct_dependencies": {"type": "array", "minItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["package", "version", "license", "role"], "properties": {"package": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "license": {"type": "string", "minLength": 1}, "role": {"type": "string", "minLength": 1}}}},
    "license_counts": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 0}},
    "license_notes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "install_script_packages": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "install_policy": {"type": "string", "minLength": 1},
    "vulnerability_audit": {"type": "object", "additionalProperties": false, "required": ["severity_counts", "advisory_ids", "affected_packages"], "properties": {"severity_counts": {"type": "object", "additionalProperties": false, "required": ["info", "low", "moderate", "high", "critical", "total"], "properties": {"info": {"const": 0}, "low": {"const": 0}, "moderate": {"const": 0}, "high": {"type": "integer", "minimum": 1}, "critical": {"const": 0}, "total": {"type": "integer", "minimum": 1}}}, "advisory_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^GHSA-[a-z0-9-]+$"}}, "affected_packages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "redistribution": {"const": false},
    "decision": {"type": "string", "minLength": 1},
    "runtime_claim": {"const": false}
  }
}
