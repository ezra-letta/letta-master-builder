{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://letta-master-builder.local/schemas/pointers.schema.json",
  "type": "object", "additionalProperties": false, "required": ["schema_version", "execution_allowed", "pointers"],
  "properties": {"schema_version": {"const": "1.1.0"}, "execution_allowed": {"const": false}, "pointers": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "intent", "prerequisites", "target_type", "target", "authority_class", "freshness", "requirement", "owner_module", "expected_takeaway", "unavailable_behavior", "non_authority", "grants_authority"], "properties": {"id": {"type": "string", "minLength": 1}, "intent": {"type": "string", "minLength": 1}, "prerequisites": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*-[A-Z0-9][A-Z0-9.-]*$"}}, "target_type": {"enum": ["control-contract", "mandatory-module", "official-docs", "sdk-reference", "advanced-track", "runtime-canary", "legacy-boundary"]}, "target": {"type": "string", "minLength": 1}, "authority_class": {"enum": ["project-method", "official-product-docs", "released-artifact", "scaffold-control"]}, "freshness": {"enum": ["stable", "medium", "fast", "live"]}, "requirement": {"enum": ["required", "optional", "stage-gated"]}, "owner_module": {"type": ["string", "null"], "pattern": "^MOD-[0-9]{2}$"}, "source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^SRC-[A-Z0-9.-]+$"}}, "claim_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^LMB-[A-Z0-9.-]+$"}}, "expected_takeaway": {"type": "string", "minLength": 1}, "unavailable_behavior": {"type": "string", "minLength": 1}, "non_authority": {"type": "string", "minLength": 1}, "grants_authority": {"const": false}}}}}
}
