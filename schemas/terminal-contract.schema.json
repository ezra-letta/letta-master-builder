{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://letta-master-builder.local/schemas/terminal-contract.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "repository_stage", "status_axes", "allowed_states", "transition_policy", "forbidden_actions", "security_invariants", "missing_content_behavior"],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "kind": {"const": "terminal-contract"},
    "repository_stage": {"enum": ["pre-content", "authoring", "release-candidate", "published"]},
    "status_axes": {"type": "object", "additionalProperties": false, "required": ["content", "learning", "architecture", "implementation", "transfer", "assessment_integrity", "runtime", "production"], "properties": {"content": {"enum": ["unavailable", "authoring", "complete"]}, "learning": {"enum": ["not-started", "in-progress", "passed", "failed"]}, "architecture": {"enum": ["not-assessed", "passed", "failed"]}, "implementation": {"enum": ["not-assessed", "passed", "failed"]}, "transfer": {"enum": ["not-assessed", "passed", "failed"]}, "assessment_integrity": {"enum": ["unverified", "verified", "invalid"]}, "runtime": {"enum": ["not-tested", "partially-observed", "observed"]}, "production": {"enum": ["not-qualified", "qualified", "rejected"]}}},
    "allowed_states": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["state", "completion_awarded", "readiness_awarded", "runtime_validated", "production_qualified", "exit_code", "message"], "properties": {"state": {"enum": ["CURRICULUM_UNAVAILABLE", "CURRICULUM_AUTHORING", "ASSESSMENT_REQUIRED", "CURRICULUM_COMPLETE"]}, "completion_awarded": {"type": "boolean"}, "readiness_awarded": {"type": "boolean"}, "runtime_validated": {"type": "boolean"}, "production_qualified": {"type": "boolean"}, "exit_code": {"type": "integer", "minimum": 0, "maximum": 255}, "message": {"type": "string", "minLength": 1}}}},
    "transition_policy": {"type": "object", "additionalProperties": false, "required": ["current_transition", "future_states_require", "publication_does_not_imply_runtime_or_production"], "properties": {"current_transition": {"const": "none"}, "future_states_require": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "publication_does_not_imply_runtime_or_production": {"const": true}}},
    "forbidden_actions": {"type": "array", "minItems": 10, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "security_invariants": {"type": "object", "additionalProperties": false, "required": ["allow_network_on_bare_pointer", "allow_code_execution_on_bare_pointer", "allow_agent_creation_on_bare_pointer", "allow_model_calls_on_bare_pointer", "allow_side_effects_on_bare_pointer", "allow_runtime_claims_from_static_evidence", "allow_production_claims_from_curriculum_evidence"], "properties": {"allow_network_on_bare_pointer": {"const": false}, "allow_code_execution_on_bare_pointer": {"const": false}, "allow_agent_creation_on_bare_pointer": {"const": false}, "allow_model_calls_on_bare_pointer": {"const": false}, "allow_side_effects_on_bare_pointer": {"const": false}, "allow_runtime_claims_from_static_evidence": {"const": false}, "allow_production_claims_from_curriculum_evidence": {"const": false}}},
    "missing_content_behavior": {"type": "object", "additionalProperties": false, "required": ["terminal_state", "continue_to_external_targets", "infer_missing_curriculum", "promote_scaffold_to_curriculum"], "properties": {"terminal_state": {"const": "CURRICULUM_UNAVAILABLE"}, "continue_to_external_targets": {"const": false}, "infer_missing_curriculum": {"const": false}, "promote_scaffold_to_curriculum": {"const": false}}}
  }
}
