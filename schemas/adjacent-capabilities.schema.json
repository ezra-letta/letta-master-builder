{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://letta-master-builder.local/schemas/adjacent-capabilities.schema.json",
  "x-target": "capabilities/adjacent.yml",
  "title": "Revision 0.4 adjacent ecosystem checklist",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "decision_owner", "entries"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "kind": {"const": "adjacent-capability-registry"},
    "decision_owner": {"type": "string", "minLength": 1},
    "entries": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "order", "name", "disposition", "owner_module", "relevance", "pointer_ids", "non_claim"],
        "properties": {
          "id": {"type": "string", "pattern": "^ADJ-[A-Z0-9-]+$"},
          "order": {"type": "integer", "minimum": 1, "maximum": 18},
          "name": {"type": "string", "minLength": 1},
          "disposition": {"enum": ["core", "awareness", "planned-elective", "out-of-scope", "review-pending"]},
          "owner_module": {"type": "string", "pattern": "^MOD-(0[0-9]|1[0-3])$"},
          "relevance": {"type": "string", "minLength": 1},
          "pointer_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^PTR-[A-Z0-9.-]+$"}},
          "non_claim": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
