{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://letta-master-builder.local/schemas/core-capabilities.schema.json",
  "x-target": "capabilities/core.yml",
  "title": "Revision 0.4 core capability taxonomy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "taxonomy_version", "baseline_version_ids", "capabilities"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "kind": {"const": "core-capability-registry"},
    "taxonomy_version": {"const": "0.1.0"},
    "baseline_version_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^VER-[A-Z0-9-]+$"}},
    "capabilities": {
      "type": "array",
      "minItems": 26,
      "maxItems": 26,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "order", "name", "status", "depth", "classification", "owner_module", "claim_bearing", "source_ids", "discrepancy_ids", "export_symbols", "practicum_ids", "non_claims"],
        "properties": {
          "id": {"type": "string", "pattern": "^CAP-[A-Z0-9-]+$"},
          "order": {"type": "integer", "minimum": 1, "maximum": 26},
          "name": {"type": "string", "minLength": 1},
          "status": {"enum": ["planned", "vertical-slice"]},
          "depth": {"enum": ["implement", "design", "select", "recognize", "excluded"]},
          "classification": {"enum": ["product-capability", "project-method"]},
          "owner_module": {"type": "string", "pattern": "^MOD-(0[0-9]|1[0-3])$"},
          "claim_bearing": {"type": "boolean"},
          "source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^SRC-[A-Z0-9.-]+$"}},
          "discrepancy_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^DISC-[A-Z0-9.-]+$"}},
          "export_symbols": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "practicum_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(?:FIX|SCN)-[A-Z0-9.-]+$"}},
          "non_claims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
