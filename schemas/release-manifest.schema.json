{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://letta-master-builder.local/schemas/release-manifest.schema.json",
  "x-target": "release/manifest.yml",
  "title": "Revision 0.4 release-candidate evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "status", "curriculum_version", "design_revision", "evidence_cutoff", "package_tuple", "docs_source_id", "toolchain", "lanes", "artifacts", "dependency_audit", "dependency_review", "observed_upstream_drift", "independent_review", "runtime_validation", "non_claims"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"const": "REL-REVISION-0-4-RC"},
    "status": {"const": "release-candidate-publication-blocked"},
    "curriculum_version": {"const": "0.4.0"},
    "design_revision": {"const": "0.4"},
    "evidence_cutoff": {"type": "string", "format": "date"},
    "package_tuple": {"type": "object", "additionalProperties": false, "required": ["agent_sdk", "sdk_declared_runtime", "standalone_runtime"], "properties": {"agent_sdk": {"type": "string", "pattern": "^VER-"}, "sdk_declared_runtime": {"type": "string", "pattern": "^VER-"}, "standalone_runtime": {"type": "string", "pattern": "^VER-"}}},
    "docs_source_id": {"type": "string", "pattern": "^SRC-DOCS-"},
    "toolchain": {"type": "object", "additionalProperties": false, "required": ["node", "typescript"], "properties": {"node": {"const": ">=22.19.0"}, "typescript": {"const": "5.9.3"}}},
    "lanes": {"type": "object", "additionalProperties": false, "required": ["primary", "contrast", "hosted_runtime"], "properties": {"primary": {"const": "agent-sdk-node-local"}, "contrast": {"const": "agent-sdk-node-cloud"}, "hosted_runtime": {"const": "unknown-not-tested"}}},
    "artifacts": {"type": "object", "additionalProperties": false, "required": ["curriculum_available", "mandatory_modules", "practicum_specs", "assessment_governance", "vertical_slice", "sdk_export_ledger"], "properties": {"curriculum_available": {"const": true}, "mandatory_modules": {"const": "ready:14:71001-words"}, "practicum_specs": {"const": "ready-unexecuted"}, "assessment_governance": {"const": "ready-unexecuted"}, "vertical_slice": {"enum": ["planned", "compile-verified"]}, "sdk_export_ledger": {"enum": ["planned", "generated"]}}},
    "dependency_audit": {"type": "object", "additionalProperties": false, "required": ["control_plane", "compile_only_slice", "publication_blocked", "advisory_ids", "affected_packages"], "properties": {"control_plane": {"const": "zero-known-vulnerabilities"}, "compile_only_slice": {"const": "known-upstream-advisories"}, "publication_blocked": {"const": true}, "advisory_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^GHSA-[a-z0-9-]+$"}}, "affected_packages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "dependency_review": {"const": "release/dependency-review.yml"},
    "observed_upstream_drift": {"const": "maintenance/upstream-drift-review.yml"},
    "independent_review": {"type": "object", "additionalProperties": false, "required": ["status", "completed_at", "independence_basis", "attestation_status", "review_records", "closed_findings", "remaining_external_blockers"], "properties": {"status": {"const": "multi-agent-review-completed"}, "completed_at": {"type": "string", "format": "date-time"}, "independence_basis": {"const": "separate-reviewer-agent-identities-and-task-records"}, "attestation_status": {"const": "not-cryptographically-signed"}, "review_records": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["reviewer_agent_id", "task_id", "scope", "result"], "properties": {"reviewer_agent_id": {"type": "string", "pattern": "^agent-[0-9a-f-]{36}$"}, "task_id": {"type": "string", "pattern": "^task_[0-9]+$"}, "scope": {"type": "string", "minLength": 1}, "result": {"const": "pass"}}}}, "closed_findings": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "remaining_external_blockers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "runtime_validation": {"const": "not-performed"},
    "non_claims": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}}
  }
}
