{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://letta-master-builder.local/schemas/sdk-exports.schema.json",
  "x-target": "capabilities/sdk-exports.yml",
  "title": "Mechanical dual-entry Agent SDK export ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "package", "version", "integrity", "generated_from", "generator", "entries"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "kind": {"const": "sdk-export-ledger"},
    "package": {"const": "@letta-ai/letta-agent-sdk"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "integrity": {"type": "string", "pattern": "^sha512-"},
    "generated_from": {"type": "array", "const": [".", "./client"]},
    "generator": {"const": "scripts/generate-sdk-export-ledger.mjs"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "entrypoint", "symbol", "runtime_value", "declaration_kinds", "members", "disposition", "capability_ids", "rationale"],
        "properties": {
          "id": {"type": "string", "pattern": "^EXP-(ROOT|CLIENT)-[0-9]{4}$"},
          "entrypoint": {"enum": [".", "./client"]},
          "symbol": {"type": "string", "minLength": 1},
          "runtime_value": {"type": "boolean"},
          "declaration_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "members": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "disposition": {"enum": ["claim-bearing", "bundled-supporting", "awareness-only", "review-pending", "excluded"]},
          "capability_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^CAP-[A-Z0-9-]+$"}},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
