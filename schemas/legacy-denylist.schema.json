{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://letta-master-builder.local/schemas/legacy-denylist.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "default_action", "exception_policy", "rules", "reviewed_exceptions"],
  "properties": {
    "schema_version": { "const": "1.0.0" }, "default_action": { "const": "fail" },
    "exception_policy": { "type": "object", "additionalProperties": false, "required": ["default", "require_exact_path", "require_named_reviewer", "require_rationale", "broad_directory_exceptions"], "properties": {
      "default": { "const": "deny" }, "require_exact_path": { "const": true }, "require_named_reviewer": { "const": true }, "require_rationale": { "const": true }, "broad_directory_exceptions": { "const": false }
    } },
    "rules": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "pattern", "severity", "include", "exclude", "reason", "replacement_pointer"], "properties": {
      "id": { "type": "string", "pattern": "^LEG-[0-9]{3}$" }, "pattern": { "type": "string", "minLength": 1 }, "severity": { "enum": ["error", "warning"] },
      "include": { "$ref": "#/$defs/paths" }, "exclude": { "$ref": "#/$defs/paths" }, "reason": { "type": "string", "minLength": 1 }, "replacement_pointer": { "type": "string", "minLength": 1 }
    } } },
    "reviewed_exceptions": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["rule_id", "path", "reviewer", "rationale", "created_at"], "properties": {
      "rule_id": { "type": "string", "pattern": "^LEG-[0-9]{3}$" }, "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[?*{}\\[\\]])[^\\\\]+$" }, "reviewer": { "type": "string", "minLength": 1 }, "rationale": { "type": "string", "minLength": 1 }, "created_at": { "type": "string", "format": "date" }, "expires_at": { "type": "string", "format": "date" }
    } } }
  },
  "$defs": { "paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "pattern": "^(?:\\*\\*/\\*|(?!(?:/|.*(?:^|/)\\.\\.(?:/|$)))(?!.*[?*{}\\[\\]])[^\\\\]+)$" } } }
}
